  if(!Number.isFinite(radius))throw Error(`원자 반지름을 찾을 수 없습니다 (${chain} ${res} ${num}${ins} ${name}).`);
  if(coords.some(v=>v===''||!Number.isFinite(Number(v))))throw Error(`좌표를 확인하세요 (${chain} ${res} ${num}${ins} ${name}).`);
