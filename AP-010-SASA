function neighbors(a,cells){
 const hits=[],[i,j,k]=a.cell;
 for(let x=i-1;x<=i+1;x++)for(let y=j-1;y<=j+1;y++)for(let z=k-1;z<=k+1;z++){
  for(const b of cells.get([x,y,z].join(','))||[]){
   if(a===b)continue;
   const dx=b.x-a.x,dy=b.y-a.y,dz=b.z-a.z,d=Math.hypot(dx,dy);
   if(d*d+dz*dz<(a.r+b.r)**2)hits.push({d,dz,angle:Math.atan2(dy,dx),r:b.r});
  }
 }
 return hits;
}
function accessibleArea(a,near){
 const step=2*a.r/slices;let exposed=0;
 for(let s=0;s<slices;s++){
  const z=-a.r+(s+.5)*step,r=Math.sqrt(a.r*a.r-z*z),arcs=[];
  let covered=false;
  for(const b of near){
   const sq=b.r*b.r-(z-b.dz)**2;if(sq<=0)continue;
   const q=Math.sqrt(sq);
   if(b.d+r<=q){covered=true;break}
   if(b.d>=r+q||b.d+q<=r||b.d===0)continue;
   const cos=(b.d*b.d+r*r-sq)/(2*b.d*r),half=Math.acos(Math.max(-1,Math.min(1,cos)));
   const start=(b.angle-half+tau)%tau,end=start+2*half;
   arcs.push([start,Math.min(end,tau)]);if(end>tau)arcs.push([0,end-tau]);
  }
  if(covered)continue;
  let last=0,open=0;
  arcs.sort((a,b)=>a[0]-b[0]);
  for(const [lo,hi] of arcs){open+=Math.max(0,lo-last);last=Math.max(last,hi)}
  exposed+=open+(tau-last);
 }
 return exposed*a.r*step;
}
async function calculate(text,progress,filename){
 const {atoms,residues}=parseStructure(text,filename),cells=spatialGrid(atoms);
 let last=performance.now();
 for(let i=0;i<atoms.length;i++){
  const a=atoms[i],area=accessibleArea(a,neighbors(a,cells));
  a.row.total+=area;if(!backbone.has(a.name))a.row.side+=area;
  if(performance.now()-last>70){await progress(i+1,atoms.length);last=performance.now()}
 }
 return [...residues.values()].sort((a,b)=>a.chain.localeCompare(b.chain)||Number(a.num)-Number(b.num)||a.ins.localeCompare(b.ins));
}
const byId=id=>document.getElementById(id),file=byId('file'),run=byId('run'),statusLine=byId('status'),output=byId('output'),body=byId('rows');
let analyzedRows=[];
const scope=byId('scope'),ranges=byId('ranges'),threshold=byId('threshold');
function pdbPosition(value){
 const m=/^(-?\d+)([A-Za-z]?)$/.exec(value);
 if(!m)throw Error('PDB 잔기 번호를 확인하세요.');
 return {n:Number(m[1]),ins:m[2]};
}
function comparePosition(a,b){return a.n-b.n || a.ins.localeCompare(b.ins)}
function parseRanges(text){
 return text.split(/[,;\n]+/).map(x=>x.trim()).filter(Boolean).map(part=>{
  const m=/^([^\s:,;]+)\s*:\s*(-?\d+[A-Za-z]?)(?:\s*-\s*(-?\d+[A-Za-z]?))?$/.exec(part);
  if(!m)throw Error('범위 형식을 확인하세요. 예: H:26-32, L:50-56');
  const lo=pdbPosition(m[2]),hi=pdbPosition(m[3]||m[2]);
  if(comparePosition(lo,hi)>0)throw Error('범위의 시작 번호가 끝 번호보다 큽니다.');
  return {part,chain:m[1]==='—'?'':m[1],lo,hi};
 });
}
function recommend(rows,regions,minRSA){
 const matched=new Set(),primary=[],review=[];
 for(const row of rows){
  if(regions){
   const pos={n:Number(row.num),ins:row.ins};
   const hits=regions.filter(r=>row.chain===r.chain&&comparePosition(pos,r.lo)>=0&&comparePosition(pos,r.hi)<=0);
   if(!hits.length)continue;
   hits.forEach(r=>matched.add(r));
  }
  if(!maxima[row.res])continue;
  const rsa=row.total/maxima[row.res]*100;
  if(rsa<minRSA)continue;
  const reasons=[];
  const special={CYS:'이황화결합 여부 확인',GLY:'WT 측쇄 없음',PRO:'주사슬 형태 확인'};
  if(special[row.res])reasons.push(special[row.res]);
  const missing=Object.keys(radii[row.res]).filter(name=>name!=='OXT'&&!row.names.has(name));
  if(missing.length)reasons.push('누락 원자 '+missing.join(', '));
  if(!row.side&&row.res!=='GLY')reasons.push('측쇄 노출 면적 0');
  (reasons.length?review:primary).push({row,rsa,reason:reasons.join(' · ')});
 }
 for(const list of [primary,review])list.sort((a,b)=>b.rsa-a.rsa||b.row.side-a.row.side);
 return {primary,review,unmatched:(regions||[]).filter(r=>!matched.has(r)).map(r=>r.part)};
}
function showCandidates(title,items,review){
 if(!items.length)return;
 const host=byId('rec-tables'),heading=document.createElement('h3'),wrap=document.createElement('div'),table=document.createElement('table');
 heading.className='subhead';heading.textContent=title;wrap.className='scroll';
 const header=table.createTHead().insertRow();
 for(const name of ['Chain','잔기','상대 SASA (%)','측쇄 SASA (Å²)',...(review?['검토 사유']:[])]){
  const th=document.createElement('th');th.textContent=name;header.append(th);
 }
 const tbody=table.createTBody();
 for(const {row,rsa,reason} of items){
  const tr=tbody.insertRow();
  for(const value of [row.chain||'—',row.res+' '+row.num+row.ins,rsa.toFixed(1),row.side.toFixed(2),...(review?[reason]:[])])tr.insertCell().textContent=value;
 }
 wrap.append(table);host.append(heading,wrap);
}
function refreshRecommendations(){
 byId('rec-tables').replaceChildren();
 const status=byId('rec-status'),useRanges=scope.value==='ranges';
 byId('range-label').hidden=!useRanges;
 try{
  const min=threshold.valueAsNumber;
  if(!Number.isFinite(min)||min<0)throw Error('최소 상대 SASA에 0 이상의 숫자를 입력하세요.');
  const regions=useRanges?parseRanges(ranges.value):null;
  if(useRanges&&!regions.length)throw Error('CDR 또는 관심 범위를 구조 파일 번호로 입력하세요. 모든 표면을 보려면 전체 구조를 선택하세요.');
  const {primary,review,unmatched}=recommend(analyzedRows,regions,min);
  status.textContent='추천 '+primary.length+'개 · 별도 검토 '+review.length+'개'+(unmatched.length?' · 구조에서 찾지 못한 범위: '+unmatched.join(', '):'');
  showCandidates('추천 위치',primary,false);showCandidates('별도 검토',review,true);
 }catch(error){status.textContent=error.message}
}
scope.onchange=ranges.oninput=threshold.oninput=refreshRecommendations;
file.onchange=()=>{analyzedRows=[];ranges.value='';byId('recommendation').hidden=true;run.disabled=!file.files.length;output.hidden=true;body.replaceChildren();statusLine.textContent=''};
byId('form').onsubmit=async event=>{
 event.preventDefault();const pdb=file.files[0];if(!pdb)return;
 byId('recommendation').hidden=true;run.disabled=file.disabled=true;output.hidden=true;body.replaceChildren();statusLine.textContent='PDB / mmCIF 구조를 읽는 중…';
 try{
  const rows=await calculate(await pdb.text(),async(done,total)=>{statusLine.textContent=`원자 표면 계산 중 · ${Math.floor(done/total*100)}%`;await new Promise(resolve=>setTimeout(resolve,0))},pdb.name);
  const fragment=document.createDocumentFragment();
  for(const row of rows){
   const {chain,num,ins,res,total,side}=row;
   const values=[chain||'—',num+ins,res,total.toFixed(2),maxima[res]?(total/maxima[res]*100).toFixed(1):'N/A',side.toFixed(2),total>0?(side/total*100).toFixed(1):'N/A'];
   const tr=document.createElement('tr');for(const v of values){const td=document.createElement('td');td.textContent=v;tr.append(td)}fragment.append(tr);
  }
  analyzedRows=rows;
  byId('chain-hint').textContent='구조의 체인 '+[...new Set(rows.map(r=>r.chain||'—'))].join(', ')+' · 삽입 번호는 H:100A처럼 입력합니다. CDR 경계는 직접 지정합니다.';
  byId('recommendation').hidden=false;refreshRecommendations();
  body.append(fragment);output.hidden=false;statusLine.textContent=`${pdb.name} · ${rows.length.toLocaleString()}개 잔기 계산 완료`;
 }catch(error){statusLine.textContent=error.message}finally{run.disabled=file.disabled=false}
};
