 for(let i=0;i<lines.length;i++){
  const line=lines[i];
  if(line.startsWith(';')){
   const block=[line.slice(1)];
   while(++i<lines.length&&!lines[i].startsWith(';'))block.push(lines[i]);
   if(i===lines.length)throw Error('닫히지 않은 CIF 텍스트 필드입니다.');
   yield {value:block.join('\n'),literal:true};continue;
  }
