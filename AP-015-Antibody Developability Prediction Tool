        throw new Error(`${chainName} contains unsupported characters: ${invalid.join(', ')}`);
      }

      if (sequence.length < 85 || sequence.length > 150) {
        throw new Error(`${chainName} is ${sequence.length} aa long. Please enter the variable domain only.`);
      }
      return sequence;
    }

    function sideChainCharge(sequence, pH = 7.4) {
      let charge = 0;
      for (const [residue, pKa] of Object.entries(basicPka)) {
        charge += countResidue(sequence, residue) / (1 + Math.pow(10, pH - pKa));
      }
      for (const [residue, pKa] of Object.entries(acidicPka)) {
        charge -= countResidue(sequence, residue) / (1 + Math.pow(10, pKa - pH));
      }
      return charge;
    }

    function meanHydropathy(sequence) {
      return [...sequence].reduce((sum, residue) => sum + kyteDoolittle[residue], 0) / sequence.length;
    }

    function windowValues(sequence, width, calculator) {
      if (sequence.length <= width) return [calculator(sequence)];
      const values = [];
      for (let start = 0; start <= sequence.length - width; start += 1) {
        values.push(calculator(sequence.slice(start, start + width)));
      }
      return values;
    }

    function extremeWindow(sequences, width, calculator, mode = 'max') {
      const values = sequences.flatMap((sequence) => windowValues(sequence, width, calculator));
      return mode === 'max' ? Math.max(...values) : Math.min(...values);
    }

    function firstCysteine(sequence, start) {
      const position = sequence.indexOf('C', start);
      if (position < 0) throw new Error('A conserved Cys anchor could not be located.');
      return position;
    }

    function lastResiduePosition(sequence, start, stop, residue) {
      let position = -1;
      for (let index = Math.max(0, start); index < Math.min(sequence.length, stop); index += 1) {
        if (sequence[index] === residue) position = index;
      }
      if (position < 0) throw new Error(`A conserved ${residue} anchor could not be located.`);
      return position;
    }

    function lastFr4Anchor(sequence, start) {
      let position = -1;
      for (let index = start; index <= sequence.length - 4; index += 1) {
        if ((sequence[index] === 'W' || sequence[index] === 'F') && sequence[index + 3] === 'G') {
          position = index;
        }
      }
      if (position < 0) throw new Error('The FR4 [WF]xxG anchor could not be located.');
      return position;
    }

    function extractCdrProxies(vh, vl) {
      const vhCys1 = firstCysteine(vh, 15);
      const vhTrp1 = lastResiduePosition(vh, vhCys1 + 7, vhCys1 + 21, 'W');
      const vhCys2 = firstCysteine(vh, 80);
      const vhFr4 = lastFr4Anchor(vh, vhCys2 + 1);

      const vlCys1 = firstCysteine(vl, 15);
      const vlTrp1 = lastResiduePosition(vl, vlCys1 + 5, vlCys1 + 23, 'W');
      const vlCys2 = firstCysteine(vl, 75);
      const vlFr4 = lastFr4Anchor(vl, vlCys2 + 1);
      const cdrs = {
        H1: vh.slice(vhCys1 + 4, vhTrp1),
        'H2 proxy': vh.slice(vhTrp1 + 14, vhCys2 - 30),
        H3: vh.slice(vhCys2 + 1, vhFr4),
        L1: vl.slice(vlCys1 + 1, vlTrp1),
        L2: vl.slice(vlTrp1 + 15, vlTrp1 + 22),
        L3: vl.slice(vlCys2 + 1, vlFr4)
      };

      const expectedLengths = {
        H1: [7, 12], 'H2 proxy': [15, 18], H3: [5, 30],
        L1: [8, 17], L2: [7, 7], L3: [6, 13]
      };

      for (const [region, sequence] of Object.entries(cdrs)) {
        const [minimum, maximum] = expectedLengths[region];
        if (sequence.length < minimum || sequence.length > maximum) {
          throw new Error(`${region} was extracted as ${sequence.length} aa, outside the expected ${minimum}-${maximum} aa range.`);
        }
      }
      return cdrs;
    }

    function countPattern(sequence, patternSource) {
      const pattern = new RegExp(`(?=(${patternSource}))`, 'g');
      return [...sequence.matchAll(pattern)].length;
    }

    function countPatternAcross(sequences, patternSource) {
      return sequences.reduce((sum, sequence) => sum + countPattern(sequence, patternSource), 0);
    }

    function calculateSequenceFeatures(vh, vl, cdrs) {
      const fv = vh + vl;
      const cdrSegments = Object.values(cdrs);
      const cdrSequence = cdrSegments.join('');
      const vhCharge = sideChainCharge(vh);
      const vlCharge = sideChainCharge(vl);
      const hydrophobicCount = (sequence) => [...sequence].filter((residue) => 'AVILMFWY'.includes(residue)).length;
      const aromaticCount = (sequence) => [...sequence].filter((residue) => 'FWY'.includes(residue)).length;

      return {
        'VH length': vh.length,
        'VL length': vl.length,
        'Fv side-chain charge pH 7.4': vhCharge + vlCharge,
        'VH side-chain charge pH 7.4': vhCharge,
        'VL side-chain charge pH 7.4': vlCharge,
        'Fv mean hydropathy': meanHydropathy(fv),
        'CDR-proxy mean hydropathy': meanHydropathy(cdrSequence),
        'Fv Met+Trp count': countResidue(fv, 'M') + countResidue(fv, 'W'),
        'Fv acidic fraction': [...fv].filter((residue) => 'DE'.includes(residue)).length / fv.length,
        'Fv hydrophobic fraction': hydrophobicCount(fv) / fv.length,
        'CDR-proxy aromatic fraction': aromaticCount(cdrSequence) / cdrSequence.length,
        'HCDR3 length': cdrs.H3.length,
        'Fv max hydropathy window 7': extremeWindow([vh, vl], 7, meanHydropathy),
        'CDR-proxy max hydropathy window 7': extremeWindow(cdrSegments, 7, meanHydropathy),
        'CDR-proxy max positive-charge window 5': extremeWindow(cdrSegments, 5, sideChainCharge),
        'CDR-proxy side-chain charge pH 7.4': sideChainCharge(cdrSequence),
        'Fv min negative-charge window 7': extremeWindow([vh, vl], 7, sideChainCharge, 'min'),
        'Fv NXS/T sequon count': countPatternAcross([vh, vl], 'N[^P][ST]'),
        'CDR-proxy NXS/T sequon count': countPatternAcross(cdrSegments, 'N[^P][ST]'),
        'CDR-proxy labile Asn motif count': countPatternAcross(cdrSegments, 'N[GSTN]'),
        'CDR-proxy Asp isomerization motif count': countPatternAcross(cdrSegments, 'D[GSTDH]'),
        'Fv DP motif count': countPatternAcross([vh, vl], 'DP'),
        'CDR-proxy DP motif count': countPatternAcross(cdrSegments, 'DP'),
        'Extra Cys count': Math.max(0, countResidue(vh, 'C') - 2) + Math.max(0, countResidue(vl, 'C') - 2)
      };
    }

    function calculateCompositionFeatures(vh, vl, cdrs) {
      const regions = {
        VH: vh,
        VL: vl,
        CDR: Object.values(cdrs).join('')
      };
      const values = {};
      for (const [prefix, sequence] of Object.entries(regions)) {
        for (const residue of aminoAcidOrder) {
          values[prefix + '_' + residue] = countResidue(sequence, residue) / sequence.length;
        }
      }
      return values;
    }

    function modelPrediction(model, features) {
      const standardized = model.features.map((feature, index) => (
        (features[feature] - model.mean[index]) / model.scale[index]
      ));
      const contributions = standardized.map((value, index) => value * model.coef[index]);
      const linearScore = model.intercept + contributions.reduce((sum, value) => sum + value, 0);
      return { probability: sigmoid(linearScore), contributions };
    }

    function percentile(sortedValues, value) {
      let low = 0;
      let high = sortedValues.length;
      while (low < high) {
        const middle = Math.floor((low + high) / 2);
        if (sortedValues[middle] <= value) low = middle + 1;
        else high = middle;
      }
      return 100 * low / sortedValues.length;
    }

    function formatFeature(feature, value) {
      if (feature.includes('fraction')) return `${(100 * value).toFixed(1)}%`;
      if (feature.includes('length') || feature.includes('count') || feature === 'Extra Cys count') {
        return String(Math.round(value));
      }
      return value.toFixed(2);
    }

    function contributionText(model, prediction) {
      const values = model.features.map((feature, index) => ({
        label: MODEL_DATA.feature_profile[feature].label,
        contribution: prediction.contributions[index]
      }));
      const increasing = values.filter((item) => item.contribution > 0.03)
        .sort((a, b) => b.contribution - a.contribution)[0];
      const decreasing = values.filter((item) => item.contribution < -0.03)
        .sort((a, b) => a.contribution - b.contribution)[0];
      const messages = [];
      if (increasing) {
        const context = increasing.label.toLowerCase().includes('charge')
          ? ' (charge-only evidence is not definitive)'
          : '';
        messages.push(`Higher: ${increasing.label}${context}`);
      }
      if (decreasing) messages.push(`Lower: ${decreasing.label}`);
      return messages.length ? messages.join(' · ') : 'Near the cohort mean';
    }

    function ordinal(value) {
      const rounded = Math.round(value);
      const finalTwoDigits = rounded % 100;
      if (finalTwoDigits >= 11 && finalTwoDigits <= 13) return `${rounded}th`;
      if (rounded % 10 === 1) return `${rounded}st`;
      if (rounded % 10 === 2) return `${rounded}nd`;
      if (rounded % 10 === 3) return `${rounded}rd`;
      return `${rounded}th`;
    }

    function riskClass(percentileValue) {
      if (percentileValue >= 75) return { label: 'Elevated sequence risk', className: 'risk-high' };
      if (percentileValue >= 40) return { label: 'Intermediate sequence risk', className: 'risk-medium' };
      return { label: 'Lower sequence risk', className: 'risk-low' };
    }

    function referenceDomain(features) {
      const outsideFeatures = profileFeatures.filter((feature) => {
        const profile = MODEL_DATA.feature_profile[feature];
        return features[feature] < profile.min || features[feature] > profile.max;
      });
      if (!outsideFeatures.length) {
        return { short: 'Within reference feature domain', detail: 'All eight core features fall within the Jain cohort range.' };
      }
      if (outsideFeatures.length <= 2) {
        return { short: 'Use with extrapolation caution', detail: `${outsideFeatures.length} core feature(s) fall outside the Jain cohort range.` };
      }
      return { short: 'Low extrapolation confidence', detail: `${outsideFeatures.length} core features fall outside the Jain cohort range.` };
    }

    function editDistance(first, second) {
      if (first === second) return 0;
      if (!first.length) return second.length;
      if (!second.length) return first.length;
      let previous = Array.from({ length: second.length + 1 }, (_, index) => index);
      for (let row = 1; row <= first.length; row += 1) {
        const current = [row];
        for (let column = 1; column <= second.length; column += 1) {
          const substitution = previous[column - 1] + (first[row - 1] === second[column - 1] ? 0 : 1);
          current[column] = Math.min(
            current[column - 1] + 1,
            previous[column] + 1,
            substitution
          );
        }
        previous = current;
      }
      return previous[second.length];
    }

    function pairedSequenceSimilarity(vh, vl, reference) {
      const distance = editDistance(vh, reference.vh) + editDistance(vl, reference.vl);
      const denominator = Math.max(vh.length, reference.vh.length)
        + Math.max(vl.length, reference.vl.length);
      return 100 * (1 - distance / denominator);
    }

    function findExactReference(vh, vl) {
      return [...MODEL_DATA.references, ...(MODEL_DATA.external_references || [])]
        .find((reference) => reference.vh === vh && reference.vl === vl);
    }

    function nearestAntibodies(vh, vl) {
      return MODEL_DATA.references.map((reference) => ({
        ...reference,
        similarity: pairedSequenceSimilarity(vh, vl, reference)
      })).sort((a, b) => b.similarity - a.similarity).slice(0, 5);
    }

    function formatAssayNumber(value) {
      if (value === null || value === undefined) return 'not supplied';
      if (Math.abs(value) >= 100) return value.toFixed(0);
      if (Math.abs(value) >= 1) return value.toFixed(2);
      return value.toFixed(3);
    }

    function observedEvidence(reference, key) {
      const assays = reference.assays.filter((assay) => groupAssays[key].includes(assay.name));
      if (!assays.length) return 'No assay label was supplied for this group';
      const flagged = assays.filter((assay) => assay.flag);
      if (!flagged.length) return 'Reported constituent assays were within the paper thresholds';
      return flagged.map((assay) => (
        assay.value === null
          ? assay.name + ' reported as a flag (numeric value not supplied)'
          : assay.name + ' ' + formatAssayNumber(assay.value) + ' '
            + assay.rule + ' ' + formatAssayNumber(assay.threshold)
      )).join(' · ');
    }

    function hydrophobicRescue(features) {
      const spec = MODEL_DATA.hydrophobic_rescue;
      const evidence = spec.features.map((feature) => ({
        feature,
        value: features[feature],
        threshold: spec.thresholds[feature],
        pass: features[feature] >= spec.thresholds[feature]
      }));
      return {
        active: evidence.every((item) => item.pass),
        evidence,
        appliesTo: new Set(spec.applies_to)
      };
    }

    function hydrophobicEvidenceText(rescue) {
      return rescue.evidence.map((item) => (
        MODEL_DATA.feature_profile[item.feature].label + ' '
        + formatFeature(item.feature, item.value) + ' vs rescue cutoff '
        + formatFeature(item.feature, item.threshold)
      )).join(' · ');
    }

    function sequenceAlertText(features, rescue) {
      const alerts = [];
      if (features['Fv NXS/T sequon count'] > 0) alerts.push(`Fv NXS/T: ${features['Fv NXS/T sequon count']}`);
      if (features['CDR-proxy NXS/T sequon count'] > 0) alerts.push(`CDR NXS/T: ${features['CDR-proxy NXS/T sequon count']}`);
      if (features['CDR-proxy labile Asn motif count'] > 0) alerts.push(`CDR labile Asn: ${features['CDR-proxy labile Asn motif count']}`);
      if (features['CDR-proxy Asp isomerization motif count'] > 0) alerts.push(`CDR Asp liability: ${features['CDR-proxy Asp isomerization motif count']}`);
      if (features['CDR-proxy DP motif count'] > 0) alerts.push(`CDR DP: ${features['CDR-proxy DP motif count']}`);
      if (features['Extra Cys count'] > 0) alerts.push(`Extra Cys: ${features['Extra Cys count']}`);
      if (features['HCDR3 length'] >= 18) alerts.push(`Long HCDR3: ${features['HCDR3 length']} aa`);
      const rescueText = rescue.active
        ? '<strong>Hydrophobic-burden rescue active:</strong> all three conservative hydrophobic criteria were met. This adds G1–G3 screen calls even when charge-driven model scores are below cutoff.'
        : '<strong>Hydrophobic-burden rescue inactive:</strong> not all three conservative hydrophobic criteria were met.';
      const motifText = alerts.length
        ? `<strong>Other sequence alerts:</strong> ${alerts.join(' · ')}. These motifs require structural/exposure review and are not red flags by themselves.`
        : '<strong>Other sequence alerts:</strong> No tested simple liability motif or long HCDR3 alert was detected.';
      return rescueText + '<br>' + motifText
        + '<br><strong>Charge handling:</strong> charge percentiles remain visible, but G1 requires an independent composition-model confirmation; a high charge value is not presented as an experimental assay result.';
    }

    function statusBadge(flag, observed) {
      if (flag === null || flag === undefined) {
        return '<span class="status-pill">Not reported</span>';
      }
      const label = flag ? 'FLAG' : 'Within threshold';
      const className = flag ? 'status-flag' : 'status-clear';
      const prefix = observed ? 'Observed ' : 'Predicted ';
      return '<span class="status-pill ' + className + '">' + prefix + label + '</span>';
    }

    function predictedGroupCalls(predictions, features) {
      const classifierCalls = {};
      const baseCalls = {};
      const calls = {};
      for (const key of ['g1', 'g2', 'g3', 'g4']) {
        classifierCalls[key] = predictions[key].probability >= MODEL_DATA.models[key].decision_threshold;
        baseCalls[key] = classifierCalls[key];
        calls[key] = baseCalls[key];
      }
      const confirmationModel = MODEL_DATA.confirmatory_models.g1_composition;
      const confirmation = modelPrediction(confirmationModel, features);
      const confirmationCall = confirmation.probability >= confirmationModel.decision_threshold;
      baseCalls.g1 = classifierCalls.g1 && confirmationCall;
      calls.g1 = baseCalls.g1;
      const rescue = hydrophobicRescue(features);
      if (rescue.active) {
        for (const key of MODEL_DATA.hydrophobic_rescue.applies_to) calls[key] = true;
      }
      return { calls, baseCalls, classifierCalls, rescue, confirmation, confirmationCall };
    }

    function renderObservedGroups(reference) {
      return ['g1', 'g2', 'g3', 'g4'].map((key, index) => {
        const flag = reference.group_flags[index];
        const source = reference.source_type === 'external'
          ? 'External assay label supplied for calibration'
          : 'Jain et al. experimental dataset';
        const interpretation = flag === null || flag === undefined
          ? 'This group was not reported for the external example'
          : flag
            ? 'At least one reported constituent assay crossed its cutoff'
            : 'No reported constituent assay crossed its cutoff';
        return '<tr>'
          + '<td>' + groupLabels[key] + '</td>'
          + '<td>' + statusBadge(flag, true) + '</td>'
          + '<td>' + observedEvidence(reference, key) + '</td>'
          + '<td>' + interpretation + '</td>'
          + '<td>' + source + '</td>'
          + '</tr>';
      }).join('');
    }

    function renderPredictedGroups(predictions, callResult) {
      return ['g1', 'g2', 'g3', 'g4'].map((key) => {
        const model = MODEL_DATA.models[key];
        const prediction = predictions[key];
        const calls = callResult.calls;
        const rescued = callResult.rescue.active
          && callResult.rescue.appliesTo.has(key)
          && !callResult.baseCalls[key];
        const g1Consensus = key === 'g1';
        const confirmationModel = MODEL_DATA.confirmatory_models.g1_composition;
        const confirmationScore = Math.round(100 * callResult.confirmation.probability);
        const confirmationCutoff = Math.round(100 * confirmationModel.decision_threshold);
        const score = Math.round(100 * prediction.probability);
        const cutoff = Math.round(100 * model.decision_threshold);
        const relativePercentile = percentile(model.reference_probability, prediction.probability);
        const confidenceNote = key === 'g4' ? ' (weakest group)' : '';
        return '<tr>'
          + '<td>' + groupLabels[key] + '</td>'
          + '<td>' + statusBadge(calls[key], false) + '</td>'
          + '<td><strong>Score ' + score + '%</strong> · cutoff ' + cutoff + '% · ' + ordinal(relativePercentile) + ' percentile'
          + (g1Consensus
            ? '<br>Composition confirmation ' + confirmationScore + '% · cutoff ' + confirmationCutoff + '%'
            : '')
          + (rescued ? '<br><strong>Hydrophobic rescue overrides the below-cutoff model score.</strong>' : '')
          + '<div class="risk-meter" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="' + score + '">'
          + '<div class="risk-fill" style="width:' + score + '%"></div></div></td>'
          + '<td>' + (rescued
            ? hydrophobicEvidenceText(callResult.rescue)
            : contributionText(model, prediction)
              + (g1Consensus
                ? ' · composition confirmation ' + (callResult.confirmationCall ? 'passed' : 'not passed')
                : '')) + '</td>'
          + '<td>' + (rescued
            ? 'Conservative rescue: 1/137 leave-one-out trigger; 0/67 no-flag controls'
            : g1Consensus
              ? 'G1 requires charge/physicochemical and composition-model consensus'
              : 'Repeated 5-fold CV ROC-AUC ' + model.auc_mean.toFixed(2) + confidenceNote) + '</td>'
          + '</tr>';
      }).join('');
    }

    function renderObservedAssays(reference) {
      return reference.assays.map((assay) => (
        '<tr>'
        + '<td>' + assay.name + '</td>'
        + '<td class="numeric">' + formatAssayNumber(assay.value) + '</td>'
        + '<td class="numeric">' + formatAssayNumber(assay.threshold) + '</td>'
        + '<td class="numeric">' + (assay.rule || '—') + '</td>'
        + '<td>' + statusBadge(assay.flag, true) + '</td>'
        + '</tr>'
      )).join('');
    }

    function renderNeighbors(vh, vl) {
      return nearestAntibodies(vh, vl).map((reference) => (
        '<tr>'
        + '<td>' + reference.n + '</td>'
        + '<td class="numeric">' + reference.similarity.toFixed(1) + '%</td>'
        + '<td class="numeric">' + reference.f + '</td>'
        + '<td>' + (reference.g === 'None' ? 'None' : reference.g.replaceAll('Group ', 'G')) + '</td>'
        + '</tr>'
      )).join('');
    }

    function featureInterpretation(feature, features, rescue) {
      if (MODEL_DATA.hydrophobic_rescue.features.includes(feature)) {
        const item = rescue.evidence.find((entry) => entry.feature === feature);
        return item.pass
          ? 'Meets the conservative hydrophobic-rescue cutoff'
          : 'Below the conservative hydrophobic-rescue cutoff';
      }
      if (feature.toLowerCase().includes('charge')) {
        return 'Context only; charge alone is not an experimental red flag';
      }
      if (feature.toLowerCase().includes('hydropathy') || feature.toLowerCase().includes('hydrophobic')) {
        return 'Hydrophobic context; surface exposure still requires structural or assay confirmation';
      }
      return 'Reference-cohort context';
    }

    function analyzeSequence() {
      byId('errorMessage').hidden = true;
      try {
        const vh = parseSequence(byId('vhSequence').value, 'VH');
        const vl = parseSequence(byId('vlSequence').value, 'VL');
        const cdrs = extractCdrProxies(vh, vl);
        const features = {
          ...calculateSequenceFeatures(vh, vl, cdrs),
          ...calculateCompositionFeatures(vh, vl, cdrs)
        };
        const predictions = {};
        for (const [key, model] of Object.entries(MODEL_DATA.models)) {
          predictions[key] = modelPrediction(model, features);
        }

        const callResult = predictedGroupCalls(predictions, features);
        const calls = callResult.calls;
        const predictedCount = ['g1', 'g2', 'g3', 'g4']
          .filter((key) => calls[key]).length;
        const continuousScore = ['g1', 'g2', 'g3', 'g4']
          .reduce((sum, key) => sum + predictions[key].probability, 0);
        const scorePercentile = percentile(MODEL_DATA.expected_flag_reference, continuousScore);
        const overallRisk = callResult.rescue.active
          ? { label: 'Elevated sequence risk', className: 'risk-high' }
          : riskClass(scorePercentile);
        const domain = referenceDomain(features);
        const reference = findExactReference(vh, vl);

        if (reference) {
          const externalReference = reference.source_type === 'external';
          const observedClass = reference.f >= 3 ? 'risk-high' : reference.f >= 1 ? 'risk-medium' : 'risk-low';
          const flaggedAssayCount = reference.assays.filter((assay) => assay.flag).length;
          byId('analysisMode').textContent = externalReference ? 'Experimental match' : 'Reference match';
          byId('analysisMode').className = 'summary-value risk-low';
          byId('matchDetail').textContent = reference.n + ' · ' + reference.clinical_status;
          byId('flagCountLabel').textContent = externalReference ? 'Known flag-group count' : 'Observed flag-group count';
          byId('expectedFlags').textContent = reference.f + ' / 4';
          byId('expectedFlags').className = 'summary-value ' + observedClass;
          byId('flagCountDetail').textContent = externalReference
            ? 'PSR, HIC, and ELISA were supplied as positive assay labels'
            : 'Paper-derived experimental result, not a model estimate';
          byId('riskContextLabel').textContent = 'Sequence-screen diagnostic';
          byId('overallPercentile').textContent = predictedCount + ' / 4 predicted';
          byId('overallPercentile').className = 'summary-value';
          byId('domainStatus').textContent = externalReference
            ? flaggedAssayCount + ' positive assay labels supplied · used for calibration, not validation'
            : flaggedAssayCount + ' of 10 assay cutoffs crossed · not independent validation';
          byId('groupResults').innerHTML = renderObservedGroups(reference);
          byId('assayResults').innerHTML = renderObservedAssays(reference);
          byId('assaySection').hidden = false;
          byId('interpretationNote').innerHTML = externalReference
            ? '<strong>Interpretation:</strong> The normalized VH/VL pair exactly matches the supplied external assay case. '
              + 'The 3/4 result is a lookup of the supplied PSR, HIC, and ELISA labels, not a blind prediction. '
              + 'The sequence-only screen also calls ' + predictedCount + '/4 because this case was used to calibrate the hydrophobic rescue; that agreement is not independent validation.'
            : '<strong>Interpretation:</strong> The normalized VH/VL pair exactly matches '
              + reference.n + ' in the 137-antibody reference set. The displayed '
              + reference.f + '/4 count is reconstructed from the published assay cutoffs. '
              + 'For diagnostic comparison, the sequence screen calls ' + predictedCount
              + '/4; this record was used during model fitting, so that agreement is not independent validation.';
        } else {
          const validation = MODEL_DATA.screening_validation;
          byId('analysisMode').textContent = 'Novel estimate';
          byId('analysisMode').className = 'summary-value';
          const nearest = nearestAntibodies(vh, vl)[0];
          byId('matchDetail').textContent = 'No exact reference match · nearest: '
            + nearest.n + ' (' + nearest.similarity.toFixed(1) + '%)';
          byId('flagCountLabel').textContent = 'Screening flag-group count';
          byId('expectedFlags').textContent = predictedCount + ' / 4';
          byId('expectedFlags').className = 'summary-value ' + overallRisk.className;
          byId('flagCountDetail').textContent = callResult.rescue.active
            ? 'Hydrophobic rescue adds G1–G3 calls to the calibrated model output'
            : 'Hard calls from four prevalence-calibrated group cutoffs';
          byId('riskContextLabel').textContent = 'Sequence-model context';
          byId('overallPercentile').textContent = callResult.rescue.active
            ? 'Hydrophobic rescue active'
            : ordinal(scorePercentile) + ' percentile';
          byId('overallPercentile').className = 'summary-value ' + overallRisk.className;
          byId('domainStatus').textContent = domain.short;
          byId('groupResults').innerHTML = renderPredictedGroups(predictions, callResult);
          byId('assaySection').hidden = true;
          byId('interpretationNote').innerHTML =
            '<strong>Interpretation:</strong> ' + domain.detail
            + ' This is a sensitivity-oriented sequence-only triage estimate. Internal cross-validation with leave-one-out rescue calibration recovered the exact 0-4 count in '
            + Math.round(100 * validation.exact_count_accuracy) + '% of antibodies and was within one flag in '
            + Math.round(100 * validation.within_one_accuracy) + '% (MAE '
            + validation.mae.toFixed(2) + '; Spearman rho ' + validation.spearman_rho.toFixed(2)
            + '). The supplied PSR/HIC/ELISA-positive case calibrated the rescue and is not an independent validation sample. This screen does not replace the Jain assays.';
        }

        byId('sequenceAlerts').innerHTML = sequenceAlertText(features, callResult.rescue);
        byId('featureResults').innerHTML = profileFeatures.map((feature) => {
          const profile = MODEL_DATA.feature_profile[feature];
          const featurePercentile = percentile(profile.values, features[feature]);
          return '<tr>'
            + '<td>' + profile.label + '</td>'
            + '<td class="numeric">' + formatFeature(feature, features[feature]) + '</td>'
            + '<td class="numeric">' + formatFeature(feature, profile.median) + '</td>'
            + '<td class="numeric">' + ordinal(featurePercentile) + '</td>'
            + '<td>' + featureInterpretation(feature, features, callResult.rescue) + '</td>'
            + '</tr>';
        }).join('');
        byId('cdrResults').innerHTML = Object.entries(cdrs).map(([region, sequence]) => (
          '<tr><td>' + region + '</td><td><code>' + sequence
          + '</code></td><td class="numeric">' + sequence.length + '</td></tr>'
        )).join('');
        byId('neighborResults').innerHTML = renderNeighbors(vh, vl);
        byId('results').hidden = false;
        byId('results').scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (error) {
        byId('results').hidden = true;
        byId('errorMessage').textContent = error.message;
        byId('errorMessage').hidden = false;
      }
    }

    function clearForm() {
      byId('vhSequence').value = '';
      byId('vlSequence').value = '';
      byId('exampleSelect').value = '';
      byId('results').hidden = true;
      byId('errorMessage').hidden = true;
      byId('vhSequence').focus();
    }

    function loadExample(name) {
      if (!name) return;
      const example = MODEL_DATA.examples[name];
      byId('vhSequence').value = example.vh;
      byId('vlSequence').value = example.vl;
    }

    byId('analyzeButton').addEventListener('click', analyzeSequence);
    byId('clearButton').addEventListener('click', clearForm);
    byId('exampleSelect').addEventListener('change', (event) => loadExample(event.target.value));
  </script>
</body>
</html>
