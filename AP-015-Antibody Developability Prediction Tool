<body>
  <main class="container">
    <h1>Antibody Developability Predictor</h1>
    <p class="subtitle">Prototype</p>

    <div class="model-note">
      <strong>Two result modes:</strong> an exact VH/VL match returns known experimental labels. A new sequence receives a sequence-only screen using four calibrated classifiers plus a conservative hydrophobic-burden rescue. G1 now requires agreement between the charge/physicochemical model and an independent amino-acid-composition model, so charge alone cannot trigger G1.
    </div>

    <div class="example-row">
      <label for="exampleSelect">Load reference example:</label>
      <select id="exampleSelect">
        <option value="">Select an antibody</option>
        <option value="dalotuzumab">Dalotuzumab — 3 experimental flag groups</option>
        <option value="briakinumab">Briakinumab — 4 experimental flag groups</option>
        <option value="ustekinumab">Ustekinumab — 1 experimental flag group</option>
        <option value="cixutumumab">Cixutumumab — 4 experimental flag groups</option>
      </select>
    </div>

    <div class="input-grid">
      <label for="vhSequence">Enter VH variable-domain sequence:
        <textarea id="vhSequence" rows="6" spellcheck="false" placeholder="e.g. EVQLVESGGGLVQPGGSLRLSCAAS..."></textarea>
      </label>
      <label for="vlSequence">Enter VL variable-domain sequence:
        <textarea id="vlSequence" rows="6" spellcheck="false" placeholder="e.g. DIQMTQSPSSLSASVGDRVTITC..."></textarea>
      </label>
    </div>

    <p class="input-help">Use one-letter amino-acid codes. FASTA headers, spaces, line breaks, digits, and alignment hyphens are accepted. Remove signal peptides and constant regions.</p>

    <div class="button-group">
      <button type="button" id="analyzeButton">Analyze Developability</button>
      <button type="button" class="secondary" id="clearButton">Clear</button>
    </div>

    <div class="error" id="errorMessage" role="alert" hidden></div>

    <section id="results" aria-live="polite" hidden>
      <div class="result-summary">
        <div class="summary-card">
          <span class="summary-label">Analysis mode</span>
          <span class="summary-value" id="analysisMode">—</span>
          <span class="summary-detail" id="matchDetail">—</span>
        </div>
        <div class="summary-card">
          <span class="summary-label" id="flagCountLabel">Flag-group count</span>
          <span class="summary-value" id="expectedFlags">—</span>
          <span class="summary-detail" id="flagCountDetail">—</span>
        </div>
        <div class="summary-card">
          <span class="summary-label" id="riskContextLabel">Sequence-model context</span>
          <span class="summary-value" id="overallPercentile">—</span>
          <span class="summary-detail" id="domainStatus">—</span>
        </div>
      </div>

      <div class="alerts" id="sequenceAlerts"></div>

      <h2>Result by Experimental Flag Group</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Group</th>
              <th>Result</th>
              <th>Evidence or model score</th>
              <th>Assays or sequence drivers</th>
              <th>Source / validation</th>
            </tr>
          </thead>
          <tbody id="groupResults"></tbody>
        </table>
      </div>

      <section id="assaySection" hidden>
        <h2>Observed or Reported Assay Evidence</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Assay</th>
                <th class="numeric">Observed value</th>
                <th class="numeric">Paper threshold</th>
                <th class="numeric">Flag rule</th>
                <th>Result</th>
              </tr>
            </thead>
            <tbody id="assayResults"></tbody>
          </table>
        </div>
      </section>

      <h2>Key Sequence Features</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Feature</th>
              <th class="numeric">Input value</th>
              <th class="numeric">Cohort median</th>
              <th class="numeric">Percentile</th>
              <th>Interpretation</th>
            </tr>
          </thead>
          <tbody id="featureResults"></tbody>
        </table>
      </div>

      <div class="two-column">
        <section>
          <h2>Automatically Extracted CDR Proxies</h2>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Region</th><th>Sequence</th><th class="numeric">Length</th></tr></thead>
              <tbody id="cdrResults"></tbody>
            </table>
          </div>
        </section>

        <section>
          <h2>Nearest Reference Sequences</h2>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Antibody</th><th class="numeric">Sequence similarity</th><th class="numeric">Observed flags</th><th>Observed groups</th></tr></thead>
              <tbody id="neighborResults"></tbody>
            </table>
          </div>
        </section>
      </div>

      <div class="limitations" id="interpretationNote"></div>
    </section>

    <div class="back-link">
      <a href="AP-000-Main.html">&larr; Back to Main</a>
    </div>
  </main>

